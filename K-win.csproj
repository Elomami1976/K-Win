<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>KWin</RootNamespace>
    <AssemblyName>K-win</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>K-win</Authors>
    <Description>Windows 11 Optimization Tool</Description>
    <Product>K-win</Product>
    <Copyright>Copyright © 2026 K-win</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives in Tests/ and is built separately. -->
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <InternalsVisibleTo Include="KWin.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <!-- English strings are in Resources/Strings.resx; fr and ar are satellite resources. -->
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>fr;ar</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

</Project>
